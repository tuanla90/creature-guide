# Copy file này thành .env rồi điền. .env đã gitignore — KHÔNG BAO GIỜ commit key thật.
# gen_audio.py + build.py tự đọc .env này.

# ===== BẮT BUỘC (ElevenLabs) =====
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ===== Tuỳ chọn (mặc định đã tốt cho tiếng Việt) =====
ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128   # account free hay lỗi -> đổi mp3_44100_96
# ELEVENLABS_STABILITY=0.35                # thấp = biểu cảm hơn
# ELEVENLABS_STYLE=0.40                    # cao = nhấn nhá hơn
# ELEVENLABS_SIMILARITY=0.75

# Override Chrome cho Remotion render (Chromium CDN bị chặn ở máy này).
# CHROME=C:\Program Files\Google\Chrome\Application\chrome.exe
