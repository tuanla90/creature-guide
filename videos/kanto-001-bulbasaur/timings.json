{"00": [{"text": "Cứ tám con Bulbasaur", "start": 0.0, "end": 1.248, "words": [{"w": "Cứ", "s": 0.0, "e": 0.312}, {"w": "tám", "s": 0.312, "e": 0.624}, {"w": "con", "s": 0.624, "e": 0.936}, {"w": "Bulbasaur", "s": 0.936, "e": 1.248}]}, {"text": "chào đời, thì bảy", "start": 1.248, "end": 2.496, "words": [{"w": "chào", "s": 1.248, "e": 1.56}, {"w": "đời,", "s": 1.56, "e": 1.872}, {"w": "thì", "s": 1.872, "e": 2.184}, {"w": "bảy", "s": 2.184, "e": 2.496}]}, {"text": "con là đực.", "start": 2.496, "end": 3.431, "words": [{"w": "con", "s": 2.496, "e": 2.807}, {"w": "là", "s": 2.807, "e": 3.119}, {"w": "đực.", "s": 3.119, "e": 3.431}]}, {"text": "Và suốt hai giai đoạn", "start": 3.431, "end": 4.991, "words": [{"w": "Và", "s": 3.431, "e": 3.743}, {"w": "suốt", "s": 3.743, "e": 4.055}, {"w": "hai", "s": 4.055, "e": 4.367}, {"w": "giai", "s": 4.367, "e": 4.679}, {"w": "đoạn", "s": 4.679, "e": 4.991}]}, {"text": "đầu đời, bạn gần như", "start": 4.991, "end": 6.551, "words": [{"w": "đầu", "s": 4.991, "e": 5.303}, {"w": "đời,", "s": 5.303, "e": 5.615}, {"w": "bạn", "s": 5.615, "e": 5.927}, {"w": "gần", "s": 5.927, "e": 6.239}, {"w": "như", "s": 6.239, "e": 6.551}]}, {"text": "không thể biết con nào", "start": 6.551, "end": 8.11, "words": [{"w": "không", "s": 6.551, "e": 6.863}, {"w": "thể", "s": 6.863, "e": 7.175}, {"w": "biết", "s": 7.175, "e": 7.487}, {"w": "con", "s": 7.487, "e": 7.798}, {"w": "nào", "s": 7.798, "e": 8.11}]}, {"text": "là cái.", "start": 8.11, "end": 8.734, "words": [{"w": "là", "s": 8.11, "e": 8.422}, {"w": "cái.", "s": 8.422, "e": 8.734}]}, {"text": "Cho tới ngày", "start": 8.734, "end": 9.67, "words": [{"w": "Cho", "s": 8.734, "e": 9.046}, {"w": "tới", "s": 9.046, "e": 9.358}, {"w": "ngày", "s": 9.358, "e": 9.67}]}, {"text": "nó nở hoa.", "start": 9.67, "end": 10.606, "words": [{"w": "nó", "s": 9.67, "e": 9.982}, {"w": "nở", "s": 9.982, "e": 10.294}, {"w": "hoa.", "s": 10.294, "e": 10.606}]}], "01": [{"text": "Đây là Kanto.", "start": 0.0, "end": 0.968, 